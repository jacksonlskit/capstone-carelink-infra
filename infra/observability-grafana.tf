# ==============================================================================
# Grafana admin login
# ------------------------------------------------------------------------------
# Terraform owns the secret, so it carries the team's Project tag (the nightly
# cleanup skips it), is encrypted with our "secrets" KMS key and is rebuilt
# like everything else. External Secrets copies it into the Kubernetes Secret
# "grafana-admin" in the monitoring namespace
# (observability/secrets/grafana-admin.yaml), which the Grafana chart uses
# (admin.existingSecret).
#
# The password is generated by Secrets Manager the first time the secret is
# deployed, and the pipeline writes it straight into the secret. It never
# appears in Git, in a plan or in the Terraform state, which everyone in the
# AWS account can read. A password generated by Terraform would end up in the
# state: the nightly cleanup deletes the state, the morning recovery re-imports
# every resource, and importing a secret version stores its value.
#
# Rotation and the one-time Grafana reset:
# docs/sre/runbooks/grafana-admin-password.md
# ==============================================================================

resource "aws_secretsmanager_secret" "grafana_admin" {
  name        = "${local.name_prefix}-grafana-admin" # key used by observability/secrets/grafana-admin.yaml
  description = "Grafana admin login for the ${var.environment} monitoring stack (read by External Secrets)"
  kms_key_id  = aws_kms_key.this["secrets"].arn

  tags = local.common_tags
}

# Gives the secret its first value. This has no AWS object to adopt, so after a
# recovery it runs again on the next apply, but it changes nothing once the
# secret has a value.
resource "terraform_data" "grafana_admin_first_value" {
  triggers_replace = [aws_secretsmanager_secret.grafana_admin.arn]

  provisioner "local-exec" {
    interpreter = ["/bin/bash", "-c"]
    environment = {
      SECRET_ID  = aws_secretsmanager_secret.grafana_admin.arn
      AWS_REGION = var.aws_region
    }
    command = <<-EOT
      set -euo pipefail
      versions=$(aws secretsmanager list-secret-version-ids --secret-id "$SECRET_ID" --query 'length(Versions)' --output text)
      if [[ "$versions" != "0" ]]; then
        echo "Grafana admin secret already has a value; leaving it unchanged."
        exit 0
      fi
      umask 077
      file=$(mktemp)
      trap 'rm -f "$file"' EXIT
      password=$(aws secretsmanager get-random-password --password-length 32 --exclude-punctuation --query RandomPassword --output text)
      printf '{"admin-user":"admin","admin-password":"%s"}' "$password" >"$file"
      aws secretsmanager put-secret-value --secret-id "$SECRET_ID" --secret-string "file://$file" >/dev/null
      echo "Grafana admin secret: first value generated by Secrets Manager."
    EOT
  }
}

# ==============================================================================
# Grafana GitHub sign-in (ADR 0011)
# ------------------------------------------------------------------------------
# Client ID and secret of the environment's Grafana GitHub OAuth App (created by
# hand in the organization carelink-group03; GitHub has no API for it). Stored
# by a person with scripts/set-argocd-oauth-secret.sh <env> grafana, never by
# Terraform, for the same reason as above: an imported version would put the
# value into the state. Value format: {"clientID": "...", "clientSecret": "..."}
# External Secrets copies it into the Kubernetes Secret "grafana-github-oauth"
# (observability/secrets/grafana-github-oauth.yaml), which Grafana reads as
# GF_AUTH_GITHUB_CLIENT_ID / GF_AUTH_GITHUB_CLIENT_SECRET.
# ==============================================================================

resource "aws_secretsmanager_secret" "grafana_github_oauth" {
  name        = "${local.name_prefix}-grafana-github-oauth" # key used by observability/secrets/grafana-github-oauth.yaml
  description = "Client ID and secret of the ${var.environment} Grafana GitHub OAuth App (org carelink-group03); stored by hand, read by External Secrets"
  kms_key_id  = aws_kms_key.this["secrets"].arn

  tags = local.common_tags
}
