// CareLink architecture (EKS). Render: dot -Tpng -Gdpi=130 architecture-diagram.dot -o architecture-diagram.png
// SOLID  = deployed and checked against the live environments (22 Nov 2026).
// DASHED = not built yet (open item, owner in docs/compliance-mapping.md).
// The brief says the submitted diagram must show what is ACTUALLY deployed:
// when an open item is built, make its node solid; delete anything never built.
digraph carelink {
  rankdir=TB;
  compound=true;
  newrank=true;
  fontname="Helvetica";
  nodesep=0.35;
  ranksep=0.55;
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#334155", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=8, color="#475569", arrowsize=0.7];
  labelloc=t;
  label=<<B>CareLink Health: AWS architecture (EKS)</B><BR/><FONT POINT-SIZE="10">Clinics in Singapore and Malaysia, PDPA. Spring PetClinic Cloud, synthetic data. Hard constraints: 99.9% in clinic hours, encrypted and private patient data, RPO 24h / RTO 4h.</FONT>>;

  users [label="Clinic staff\n(SG / MY, 08:00-20:00 SGT)", fillcolor="#fef3c7"];

  subgraph cluster_gh {
    label="GitHub: infra repo and app repo (main: PR + 1 review by someone other than the last pusher)"; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=11;
    repo_infra [label="capstone-carelink-infra\nTerraform, observability/, docs"];
    repo_app   [label="capstone-carelink-app\nPetClinic Cloud, Helm chart\nenv/staging, env/production branches"];
    actions    [label="GitHub Actions (OIDC, no stored keys)\ninfra: Snyk IaC gate, plan, apply\napp: build, Trivy scans, promote"];
    env_stg    [label="Environment: staging\n(auto deploy)"];
    env_prd    [label="Environment: production\n(approval by the DevOps owner)", fillcolor="#fee2e2"];
    repo_infra -> actions; repo_app -> actions;
    actions -> env_stg; env_stg -> env_prd [label="promote"];
  }

  subgraph cluster_aws {
    label="AWS account (shared cohort account), region us-east-1 (team decision, ADR 0007)"; style="rounded,filled"; fillcolor="#eff6ff"; color="#60a5fa"; fontsize=11;

    subgraph cluster_ident {
      label="Identity and state (oicd-bootstrap, applied locally)"; style="rounded,filled"; fillcolor="#dbeafe"; color="#93c5fd";
      oidc   [label="IAM OIDC provider\ntoken.actions.githubusercontent.com"];
      role_s [label="Role: staging\ntrusts only environment:staging"];
      role_p [label="Role: production\ntrusts only environment:production", fillcolor="#fee2e2"];
      state  [label="S3 state bucket\nversioned, encrypted, native lock\nkeys: staging/ production/"];
      oidc -> role_s; oidc -> role_p;
    }

    ecr [label="Amazon ECR\none repository per service and environment"];
    sm  [label="Secrets Manager\nDB credentials (RDS-managed),\nGrafana and Discord secrets"];
    kms [label="KMS customer-managed keys\nEBS (nodes and volumes), RDS, Secrets;\nrotation on"];

    subgraph cluster_vpc {
      label="VPC per environment: 3 public + 3 private subnets over 3 AZs\n(staging: one NAT; production: one NAT per AZ)"; style="rounded,filled"; fillcolor="#f0fdf4"; color="#4ade80"; fontsize=11;

      subgraph cluster_pub {
        label="Public subnets"; style="rounded,filled"; fillcolor="#dcfce7"; color="#86efac";
        alb [label="Application Load Balancer\n(Load Balancer Controller, from the Ingress)\nHTTPS TLS 1.2/1.3, health check /readyz"];
        nat [label="NAT gateway(s)\n(egress only)"];
      }

      subgraph cluster_eks {
        label="Private subnets: EKS 1.37, node group t3.medium, 4 nodes (min 3, max 6) per environment\nproduction cluster admin: DevOps owner only (eks.tf)"; style="rounded,filled"; fillcolor="#dcfce7"; color="#86efac";
        argo [label="Argo CD\nsyncs env/<environment> (app)\nand observability/ (staging)"];
        gw  [label="api-gateway\n2 pods on different nodes and zones"];
        cus [label="customers-service\n2 pods"];
        vet [label="vets-service\n2 pods"];
        vis [label="visits-service\n2 pods"];
        mon [label="Staging only: Prometheus, Grafana,\nLoki, Alloy, Alertmanager\n(volumes: gp3, encrypted)"];
        ci  [label="Container Insights agent\n(production app logs and pod metrics)", style="rounded,filled,dashed"];
        gw -> cus; gw -> vet; gw -> vis;
        argo -> gw [label="deploys"];
        mon -> gw [label="scrapes :8090"];
      }

      subgraph cluster_data {
        label="Private DB subnets (rds.tf): no public access"; style="rounded,filled"; fillcolor="#dcfce7"; color="#86efac";
        rds1 [label="RDS MySQL 8.0 (db.t4g.small)\nencrypted (KMS), TLS required\nproduction Multi-AZ, staging single-AZ", fillcolor="#e0e7ff"];
        rds2 [label="RDS standby (production MySQL)\nsynchronous Multi-AZ", fillcolor="#e0e7ff"];
        rds1 -> rds2 [label="sync replication", dir=both];
      }
    }

    subgraph cluster_obs {
      label="Alarms, alerts and audit (monitoring.tf, observability/)"; style="rounded,filled"; fillcolor="#fdf4ff"; color="#d8b4fe"; fontsize=11;
      cwl  [label="CloudWatch Logs (KMS)\nEKS control plane incl. audit, RDS, Lambda"];
      cwm  [label="CloudWatch metrics\nALB, RDS"];
      alm  [label="CloudWatch alarms\nRDS, error burst"];
      sns  [label="SNS (KMS-encrypted)"];
      lam  [label="Lambda discord-notify\n(staging)"];
      disc [label="Discord channel\n(alerts, fired live 21 Nov)", fillcolor="#fef3c7"];
      mail [label="Email / production\nsubscriber", style="rounded,filled,dashed", fillcolor="#fef3c7"];
      dash [label="CloudWatch dashboard\n'is it healthy right now?'"];
      rdsev [label="RDS event subscription\nfailover / failure / backup"];
      ct   [label="CloudTrail Event history (90 days)\nrecords every secret read"];
      cwl -> alm [label="metric filter"]; cwm -> alm; alm -> sns; rdsev -> sns;
      sns -> lam [label="staging"]; lam -> disc; sns -> mail [style=dashed];
      cwm -> dash; alm -> dash [label="status"];
    }

    subgraph cluster_bk {
      label="Backup and recovery (RPO <= 24h, RTO <= 4h)"; style="rounded,filled"; fillcolor="#fff7ed"; color="#fdba74";
      bk   [label="Automated backups + PITR\nretention 7 days"];
      rst  [label="Restore drill into STAGING\n(demo evidence, timed)", style="rounded,filled,dashed"];
      bk -> rst [style=dashed];
    }
  }

  users -> alb [label="HTTPS"];
  alb -> gw;
  cus -> rds1; vet -> rds1; vis -> rds1;
  rds1 -> bk [label="daily backup"];

  actions -> oidc [label="OIDC JWT -> STS", lhead=cluster_ident];
  role_s -> state [label="plan/apply"]; role_p -> state;
  actions -> ecr [label="push images"];
  repo_app -> argo [label="GitOps pull", lhead=cluster_eks];
  ecr -> gw [label="image pull"];
  sm -> cus [label="DB creds (External Secrets)"];
  kms -> rds1;
  mon -> disc [label="Alertmanager"];
  ci -> cwl [style=dashed, label="app logs"]; ci -> cwm [style=dashed, label="pod metrics"];
  alb -> cwm; rds1 -> cwm; rds1 -> rdsev; rds1 -> cwl [label="error/slow logs"];

  subgraph cluster_legend {
    label="Legend"; style="rounded"; color="#94a3b8"; fontsize=10;
    l1 [label="Deployed (checked 22 Nov 2026)"];
    l2 [label="Not built yet\n(open item, see compliance mapping)", style="rounded,filled,dashed"];
    l1 -> l2 [style=invis];
  }
}
